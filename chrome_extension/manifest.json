{
  "manifest_version": 3,
  "name": "Faceit CS2 Predictor",
  "version": "1.4.3",
  "description": "ML-прогноз победы, статы 10 игроков, флаги смурфов, вето-помощник и сводка для Discord в комнате FACEIT.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.faceit.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["model.json"],
      "matches": ["https://www.faceit.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Faceit CS2 Predictor",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.faceit.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
